# ⚠️ IMPORTANT: This is a template file. Create a .env file in the root directory with your actual values.
# NEVER commit the .env file to git. It's listed in .gitignore for your security.

# ==================== DATABASE ====================
# MongoDB Connection URI
# Local: mongodb://localhost:27017/xor_dsa
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/xor_dsa?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/xor_dsa

# ==================== SERVER ====================
PORT=5000
NODE_ENV=development
# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
# Admin URL (for CORS)
ADMIN_URL=http://localhost:5174

# ==================== AUTHENTICATION ====================
# Generate strong random strings for secrets
# Example: openssl rand -hex 32
JWT_SECRET=YOUR_JWT_SECRET_KEY_HERE
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET_KEY_HERE
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d

# ==================== EMAIL (SMTP) ====================
# Leave empty if not configured. Configure manually with your SMTP provider.
# Example providers: Gmail, SendGrid, AWS SES, Brevo, etc.
EMAIL_USER=
EMAIL_PASS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_FROM=noreply@xor-dsa.com

# ==================== FILE STORAGE (CLOUDINARY) ====================
# Sign up at https://cloudinary.com/ to get these credentials
# Leave empty and configure manually
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==================== CACHING (REDIS) ====================
# Redis Connection URL
# Local: redis://localhost:6379
# Cloud: redis://:password@host:port
# Leave empty if not using Redis caching
REDIS_URL=redis://localhost:6379

# ==================== LOGGING ====================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# ==================== SECURITY ====================
# Rate limiting (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==================== FEATURES (FUTURE) ====================
# Payment Gateway (when premium features are added)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=

# OAuth Providers (when social login is added)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# AI Services (for future AI features)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# ==================== NOTES ====================
# - Never hardcode secrets in your code
# - Keep this file in version control (for reference)
# - Create .env with your actual secrets (add to .gitignore)
# - Use strong, random values for JWT_SECRET and JWT_REFRESH_SECRET
# - Change NODE_ENV to 'production' when deploying
